# LLM backend (OpenAI-compatible endpoint, e.g. OpenRouter)
# ARCHMAX_* only. The legacy AGENT_* names are no longer read at all, so an older
# .env carrying them fails with "Missing required environment variable:
# ARCHMAX_API_KEY" — rename the keys rather than expecting a fallback.
# `.env` is read from the workspace root (--root / rootDir); the real process
# environment wins over it, and the workspace root wins over a .env in the
# directory you happened to start the process in.
ARCHMAX_API_BASE_URL=https://openrouter.ai/api/v1
ARCHMAX_API_KEY=your-api-key-here
ARCHMAX_MODEL=anthropic/claude-sonnet-4.6

# Optional model tuning
# ARCHMAX_TEMPERATURE=0
# ARCHMAX_MAX_TOKENS=4096
